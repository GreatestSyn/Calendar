# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Optional Telegram Bot token created via @BotFather.
# Can also be set directly in the in-app Telegram settings dialog.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_ADMIN_CHAT_ID: Optional Telegram Chat ID for administrator approval notifications.
TELEGRAM_ADMIN_CHAT_ID=""

# TELEGRAM_CHANNEL_CHAT_ID: Optional Telegram Channel / Group Chat ID for public announcements.
TELEGRAM_CHANNEL_CHAT_ID=""

# TELEGRAM_ADMIN_TOPIC_ID: Optional Telegram Topic ID (message_thread_id) for admin approvals in forum supergroups.
TELEGRAM_ADMIN_TOPIC_ID=""

# TELEGRAM_EVENTS_TOPIC_ID: Optional Telegram Topic ID (message_thread_id) for event announcements in forum supergroups.
TELEGRAM_EVENTS_TOPIC_ID=""

# GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=""

# ADMIN_EMAILS: Comma-separated list of Google email addresses permitted to act as administrators
# e.g. "admin@example.com, organizer@example.com"
ADMIN_EMAILS=""

# SESSION_SECRET: Secret string used to sign session cookies
SESSION_SECRET="your-session-secret-change-in-production"

# PORT: Server port (defaults to 3001)
PORT=3001
